# ================================================================================
# ОБЯЗАТЕЛЬНЫЕ настройки (лаунчер отказывается стартовать без них):
# ================================================================================
# IMAGE="vllm/vllm-openai:nightly-8e2beaa3bff595577a069d49d96bde9074294ec2@sha256:167ccd8696bc09f1b63301185134e04b883623f8adcbd8e3a0ec3140a193abcf"
#                # обязательно -- конкретный закреплённый nightly (тег = коммит vLLM); плавающие теги отклоняются
# API_KEY=                                     # на loopback необязателен: создаётся сам в live/api_key
#                # обязателен только для НЕ-loopback BIND (любой внешний адрес)
#                # ALLOW_NO_AUTH=1 принимается ТОЛЬКО вместе с BIND=127.0.0.1
# MODEL_REVISION=<40-hex коммит SHA>          # обязателен при использовании MODEL_ID (не при MODEL_DIR)
# MODEL_DIR=$HOME/models/MiMo-V2.6-Pro-MOPD        # локальный каталог с весами -- ИЛИ MODEL_ID + MODEL_REVISION
#
# Как получить значения:
#   digest:    docker buildx imagetools inspect <repo>:<tag> | grep Digest
#   API-ключ:  API_KEY=$(openssl rand -hex 24)
#   ревизия:   curl -fsSL https://huggingface.co/api/models/<MODEL_ID> | python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])'
# ================================================================================
# КАЖДАЯ ручка рецепта задокументирована ЗДЕСЬ, со значением по умолчанию --
# всё можно найти и настроить в одном файле. Оба лаунчера (run-tp4-hotsplit.sh /
# run-tp4-uva.sh) и manage.sh читают ./tp4.env раньше всего; экспортированные
# переменные окружения ПОБЕЖДАЮТ файл. tp4.env в .gitignore (там может быть API_KEY).
# --- сеть (удалённый доступ): -------------------------------------------------------------------
# BIND=127.0.0.1         # ДЕФОЛТ: API отвечает ТОЛЬКО на самой машине (loopback).
#                        # С другой машины/подсети ответа нет, хотя ping проходит
#                        # (ICMP отвечает на любом интерфейсе, а API-порт -- нет). Вместо этого:
# BIND=0.0.0.0           # слушать все интерфейсы -- ТРЕБУЕТ API-ключ (сам в live/api_key
#                        # или явный ниже). Работает и один адрес: BIND=10.0.0.5
#                        # Проверить, где слушает: ss -tlnp | grep 30007
# PORT=30007             # порт API; точка входа http://<BIND>:<PORT>/v1
# CONTAINER=mimo-pro-tp4-hotsplit   # имя контейнера (run-tp4-uva.sh: mimo-pro-tp4-uva)
# ALLOW_NO_AUTH=0        # 1 = отладка на loopback БЕЗ авторизации; с любым другим BIND отклоняется
# --- источник модели: ---------------------------------------------------------------------------
# MODEL_ID=XiaomiMiMo/MiMo-V2.6-Pro-MOPD  # HF id; используется только если MODEL_DIR пуст
#                        # (тогда MODEL_REVISION выше ОБЯЗАТЕЛЕН). Получение SHA ничего не скачивает.
# MODEL_DIR=$HOME/models/MiMo-V2.6-Pro-MOPD   # локальный каталог с весами (скачать один раз, нужно сотни
#                        # ГБ диска!); если задан -- модель грузится с диска, без обращения к HF.
# HF_CACHE=$HOME/.cache/huggingface   # кэш HF, монтируется в контейнер
# SITE=                  # путь к site-packages vLLM ВНУТРИ образа; пусто = автоопределение (норма)

# НЕОБЯЗАТЕЛЬНЫЕ настройки (показаны значения по умолчанию; скопируйте файл в tp4.env и правьте):
# ================================================================================
# Ручки, которые читает scripts/run-tp4-hotsplit.sh (экспортируйте или указывайте в команде).
# Показаны значения по умолчанию, если не помечено "пример". Статичные значения проверены на
# целевом железе (2026-10-23); динамические ещё нет.

# --- сервер -------------------------------------------------------------------------------------
# MODEL_DIR=$HOME/models/MiMo-V2.6-Pro-MOPD     # пример; иначе MODEL_ID скачивается в ~/.cache/huggingface
MAX_MODEL_LEN=1048576        # контекст 1M -- дефолт лаунчера (KV ~13.5 GiB/GPU в bf16 -- см. Известные ограничения)
MAX_NUM_SEQS=1
KV_CACHE_DTYPE=auto          # auto = bf16 (рекомендуется: полная точность); fp8 вдвое меньше KV-памяти (только для очень длинного контекста)
MAX_NUM_BATCHED_TOKENS=8192  # длинный prefill
# prefix caching ВКЛЮЧЕН по умолчанию (enable_prefix_caching=True в закреплённом билде vLLM):
# повторяющиеся префиксы промптов берутся из KV-кэша (дешёвые кэшированные токены как у облачных провайдеров).
# Проверка: bash scripts/check-prefix-cache.sh
CPU_OFFLOAD_GB=128            # на rank; ОБЯЗАН покрывать банк экспертов на rank (~123 GiB для MiMo), иначе Marlin-конвертация не влезает в VRAM; pinned RAM = 4 x это значение
GPU_UTIL=0.85               # оставляет запас VRAM под конвертацию весов в формат Marlin
MOE_BACKEND=humming         # наблюдено на целевом железе (2026-10-22): единственный бэкенд, который и
#                # поддерживает MoEActivation.SILU (triton отвергает), и не делает Marlin-репак на GPU
#                # (marlin падает с OOM при UVA-выгрузке). Оба лаунчера теперь по умолчанию humming;
#                # marlin блокируется, если HOTSPLIT_ALLOW_MARLIN_UVA=1 (только отладка).
PATCH_MODEL_FILES=1          # 0 = собственный mimo_v2.py образа, хук ставится через sitecustomize

# --- hotsplit -----------------------------------------------------------------------------------
HOTSPLIT_DYNAMIC=1           # 0 = статичный hotsplit (на каждый rank)
HOTSPLIT_DRYRUN=0            # 1 = залогировать план и не трогать веса
HOTSPLIT_HOT_GIB=30          # НА RANK. Обязательно: при полной UVA-выгрузке бюджет по умолчанию 0
#                # (пустой hot-набор -> разбиение молча ничего не делает). 30 GiB -- проверенный старт.
HOTSPLIT_WEIGHTS=decode=1,prefill=0
# HOTSPLIT_COUNTS_MODE=phase-balanced  # или traffic-weighted (вклад фазы по сырому объёму)
HOTSPLIT_HOST_FLOOR_GIB=128  # прекратить разбиение, если свободная RAM хоста (с учётом всех 4 rank) упадёт ниже этого

# --- динамические обновления (HOTSPLIT_DYNAMIC=1) -----------------------------------------------
# HOTSPLIT_DYN_STEPS=2000          # шагов движка между обновлениями
# HOTSPLIT_DYN_MAX_SWAPS=2         # свапов hot<->cold на слой за обновление (ограничивает паузу)
# HOTSPLIT_DYN_DECAY=0.5           # score = decay * score + число маршрутизаций с прошлого обновления
# HOTSPLIT_DYN_MARGIN=1.25         # свап только если score входящего > margin * score исходящего
# HOTSPLIT_DYN_PRIOR_TOKENS=2000   # вес офлайн-рейтинга, в токенах декодирования
# HOTSPLIT_DYN_LOG=1               # логировать каждое обновление (+1 синхронизация устройства на обновление)
# HOTSPLIT_DYN_MAX_PLAN_ERRORS=3   # последовательных сбоев планировщика до аварийной остановки (>=1)
# HOTSPLIT_DYN_MAX_COMMIT_ERRORS=3  # последовательных неудачных/откаченных свапов до остановки (>=1)
# HOTSPLIT_TOPK=8
# HOTSPLIT_LIVE_DECODE_MAX=16      # считать только шаги с не более чем этим числом токенов

# --- NUMA ---------------------------------------------------------------------------------------
HOTSPLIT_NUMA=1              # привязать каждый worker к NUMA-узлу его GPU (нужен --cap-add SYS_NICE, ставится лаунчером)
HOTSPLIT_NUMA_POLICY=preferred   # или bind (строго; падает/OOM при заполнении узла)
# Карта GPU->NUMA (пары gpu:node). ОБЯЗАТЕЛЬНА на VM, где sysfs numa_node=-1 для каждого PCI-устройства
# (Proxmox и подобные не пробрасывают PCI NUMA-топологию). Пример для двухсокетного хоста, где
# GPU 0+1 на сокете 0, а GPU 2+3 на сокете 1 (проверить на хосте:
# `cat /sys/bus/pci/devices/0000:<bdf>/numa_node` для каждой карты):
# HOTSPLIT_NUMA_MAP="0:0,1:0,2:1,3:1"   # раскомментировать ТОЛЬКО после проверки карты на хосте (см. выше); выключено = автоопределение

# --- телеметрия ---------------------------------------------------------------------------------
# Живые счётчики маршрутизации по экспертам: каждый rank пишет counts.rank<N>.json в $LIVE_DIR
# (./live по умолчанию) -- входные данные patches/hotsplit_rerank.py для перенастройки рейтинга.
HOTSPLIT_LIVE_COUNTS=/live/counts.json   # базовый путь файла счётчиков внутри контейнера
HOTSPLIT_LIVE_SECS=600                   # секунды между сбросами счётчиков

# --- запас VRAM (резерв предварительной проверки) -----------------------------------------------
# HOTSPLIT_VRAM_RESERVE_GIB=2   # резерв под буферы CUDA-graph, workspace Marlin и последующие
#                                 выделения KV-кэша; предпроверка отказывается разбивать слой,
#                                 когда (свободный VRAM - копия hot) < этого. Минимум 2 GiB.
# --- строгий хук / обработка сбоев NUMA ---------------------------------------------------------
# HOTSPLIT_STRICT_HOOK=0        # 1 = сбой boot/NUMA-хука ФАТАЛЕН (SystemExit), а не предупреждение
# HOTSPLIT_NUMA_STRICT=0        # 1 = сбой NUMA-привязки останавливает worker (см. numa_bind.py)
# --- происхождение кода ------------------------------------------------------------------------
# Лаунчер сам определяет SITE (site-packages vLLM) внутри образа и проверяет собственные
# mimo_v2.py / mimo_v2_omni.py образа на API, который переопределяют наши патчи, до монтирования;
# укажите SITE= для переопределения. SHA-256 исходных модулей пишется в лог для сверки
# (сравните со своим списком проверенных).