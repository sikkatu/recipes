# ================================================================================
# 必填设置（缺少时启动脚本拒绝启动）：
# ================================================================================
# IMAGE="vllm/vllm-openai:nightly-8e2beaa3bff595577a069d49d96bde9074294ec2@sha256:167ccd8696bc09f1b63301185134e04b883623f8adcbd8e3a0ec3140a193abcf"
#                # 必填 —— 具体的锁定 nightly（标签 = vLLM 提交）；浮动标签被拒绝
# API_KEY=                                     # loopback 上可选：自动生成到 live/api_key
#                # 仅在非 loopback 的 BIND（任何外部地址）时必填
#                # ALLOW_NO_AUTH=1 只能与 BIND=127.0.0.1 同时使用
# MODEL_REVISION=<40位十六进制提交 SHA>          # 使用 MODEL_ID 时必填（用 MODEL_DIR 时不需要）
# MODEL_DIR=$HOME/models/MiMo-V2.6-Pro-MOPD        # 本地权重目录 —— 或使用 MODEL_ID + MODEL_REVISION
#
# 如何获取这些值：
#   digest:    docker buildx imagetools inspect <repo>:<tag> | grep Digest
#   API 密钥:  API_KEY=$(openssl rand -hex 24)
#   修订版本:  curl -fsSL https://huggingface.co/api/models/<MODEL_ID> | python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])'
# ================================================================================
# 本配方的每个配置项都记录在这里（含默认值）—— 方便在一个文件里找到和调整所有内容。
# 两个启动脚本（run-tp4-hotsplit.sh / run-tp4-uva.sh）和 manage.sh 最先读取 ./tp4.env；
# 已导出的环境变量优先于文件。tp4.env 在 .gitignore 中（可能包含 API_KEY）。
# --- 网络（远程访问）： ---------------------------------------------------------------------------
# BIND=127.0.0.1         # 默认：API 仅在本机响应（loopback）。
#                        # 从其他机器/子网无法获得响应，即使 ping 通也是如此
#                        # （ICMP 在任何接口都响应，但 API 端口不会）。改为：
# BIND=0.0.0.0           # 监听所有接口 —— 需要 API 密钥（自动生成到 live/api_key
#                        # 或在下方显式设置）。单个地址也可以：BIND=10.0.0.5
#                        # 查看监听位置：ss -tlnp | grep 30007
# PORT=30007             # API 端口；接口地址 http://<BIND>:<PORT>/v1
# CONTAINER=mimo-pro-tp4-hotsplit   # 容器名称（run-tp4-uva.sh: mimo-pro-tp4-uva）
# ALLOW_NO_AUTH=0        # 1 = 仅 loopback 无认证调试；任何其他 BIND 都被拒绝
# --- 模型来源： -----------------------------------------------------------------------------------
# MODEL_ID=XiaomiMiMo/MiMo-V2.6-Pro-MOPD  # HF 标识符；仅在 MODEL_DIR 为空时使用
#                        #（此时上面的 MODEL_REVISION 必填）。获取 SHA 不会下载任何内容。
# MODEL_DIR=$HOME/models/MiMo-V2.6-Pro-MOPD   # 本地权重目录（下载一次，需要数百 GB
#                        # 磁盘空间！）；如果设置，模型从磁盘加载，不访问 HF。
# HF_CACHE=$HOME/.cache/huggingface   # HF 缓存目录，挂载到容器中
# SITE=                  # vLLM site-packages 在镜像内部的路径；留空 = 自动检测（正常情况）

# 可选设置（显示默认值；复制本文件为 tp4.env 并编辑）：
# ================================================================================
# scripts/run-tp4-hotsplit.sh 读取的配置项（导出它们或在命令中指定）。
# 除标注"示例"外，显示的均为默认值。静态值已在目标硬件上验证（2026-10-23）；
# 动态值尚未在硬件上验证。

# --- 服务器 ---------------------------------------------------------------------------------------
# MODEL_DIR=$HOME/models/MiMo-V2.6-Pro-MOPD     # 示例；否则 MODEL_ID 下载到 ~/.cache/huggingface
MAX_MODEL_LEN=1048576        # 1M 上下文，启动脚本默认值（bf16 下 KV 约 13.5 GiB/卡 —— 见已知限制）
MAX_NUM_SEQS=1
KV_CACHE_DTYPE=auto          # auto = bf16（推荐：全精度）；fp8 将 KV 内存减半（仅用于超长上下文）
MAX_NUM_BATCHED_TOKENS=8192  # 长 prefill
# prefix caching 默认开启（锁定版本 vLLM 中 enable_prefix_caching=True）：
# 重复的提示前缀从 KV 缓存提供（类似云服务商的低价缓存 token）。
# 验证：bash scripts/check-prefix-cache.sh
CPU_OFFLOAD_GB=128            # 每 rank；必须覆盖每 rank 的专家库（MiMo 约 123 GiB），否则 Marlin 转换时 VRAM 不够；pinned RAM = 4 × 此值
GPU_UTIL=0.85               # 为 Marlin 权重格式转换保留 VRAM 余量
MOE_BACKEND=humming         # 目标硬件实测（2026-10-22）：唯一既支持 MoEActivation.SILU（triton 拒绝）
#                # 又避免 Marlin GPU 重打包（marlin 在 UVA 卸载时 OOM）的后端。两个启动脚本现在默认
#                # humming；除非 HOTSPLIT_ALLOW_MARLIN_UVA=1（仅调试），否则 marlin 被拒绝。
PATCH_MODEL_FILES=1          # 0 = 使用镜像自带的 mimo_v2.py，钩子通过 sitecustomize 安装

# --- hotsplit -----------------------------------------------------------------------------------
HOTSPLIT_DYNAMIC=1           # 0 = 静态 hotsplit（每 rank 独立）
HOTSPLIT_DRYRUN=0            # 1 = 记录计划但不动权重
HOTSPLIT_HOT_GIB=30          # 每 rank。必填：完全 UVA 卸载时默认预算为 0
#                #（空 hot 集合 -> 拆分静默无效）。30 GiB 是验证过的起始值。
HOTSPLIT_WEIGHTS=decode=1,prefill=0
# HOTSPLIT_COUNTS_MODE=phase-balanced  # 或 traffic-weighted（按原始量计算阶段贡献）
HOTSPLIT_HOST_FLOOR_GIB=128  # 当主机空闲 RAM（按全部 4 rank 计算）降到此值以下时停止拆分

# --- 动态更新（HOTSPLIT_DYNAMIC=1） --------------------------------------------------------------
# HOTSPLIT_DYN_STEPS=2000          # 两次更新之间的引擎步数
# HOTSPLIT_DYN_MAX_SWAPS=2         # 每层每次更新的 hot<->cold 交换次数（限制停顿时间）
# HOTSPLIT_DYN_DECAY=0.5           # score = decay * score + 上次更新以来的路由次数
# HOTSPLIT_DYN_MARGIN=1.25         # 仅当进入 score > margin * 离开 score 时才交换
# HOTSPLIT_DYN_PRIOR_TOKENS=2000   # 离线排名的权重（以解码 token 为单位）
# HOTSPLIT_DYN_LOG=1               # 记录每次更新（每次更新增加一次设备同步）
# HOTSPLIT_DYN_MAX_PLAN_ERRORS=3   # 连续规划器失败多少次后中止运行（>=1）
# HOTSPLIT_DYN_MAX_COMMIT_ERRORS=3  # 连续失败/回滚的权重交换多少次后中止（>=1）
# HOTSPLIT_TOPK=8
# HOTSPLIT_LIVE_DECODE_MAX=16      # 仅统计 token 数不超过此值的步数

# --- NUMA ---------------------------------------------------------------------------------------
HOTSPLIT_NUMA=1              # 将每个 worker 绑定到其 GPU 的 NUMA 节点（需要 --cap-add SYS_NICE，启动脚本已设置）
HOTSPLIT_NUMA_POLICY=preferred   # 或 bind（严格；节点满时失败/OOM）
# GPU->NUMA 映射（gpu:node 对）。在 sysfs numa_node=-1 的 VM 上必填
#（Proxmox 等不传递 PCI NUMA 拓扑）。双路主机示例：GPU 0+1 在 socket 0，
# GPU 2+3 在 socket 1（在主机上确认：
# `cat /sys/bus/pci/devices/0000:<bdf>/numa_node` 逐卡检查）：
HOTSPLIT_NUMA_MAP="0:0,1:0,2:1,3:1"

# --- 遥测 ----------------------------------------------------------------------------------------
# 实时专家路由计数器：每个 rank 将 counts.rank<N>.json 写入 $LIVE_DIR
#（默认 ./live）—— patches/hotsplit_rerank.py 重新调整排名的输入数据。
HOTSPLIT_LIVE_COUNTS=/live/counts.json   # 容器内计数器文件的基本路径
HOTSPLIT_LIVE_SECS=600                   # 计数器刷新间隔（秒）
# --- VRAM 余量（预检查保留） --------------------------------------------------------------------
# HOTSPLIT_VRAM_RESERVE_GIB=2   # 为 CUDA-graph 缓冲区、Marlin 工作区和后续 KV 缓存分配保留；
#                                 当（空闲 VRAM - hot 副本）< 此值时预检查拒绝拆分该层。下限 2 GiB。
# --- 严格钩子 / NUMA 故障处理 --------------------------------------------------------------------
# HOTSPLIT_STRICT_HOOK=0        # 1 = boot/NUMA 钩子失败是致命的（SystemExit），而非警告
# HOTSPLIT_NUMA_STRICT=0        # 1 = NUMA 绑定失败会中止 worker（见 numa_bind.py）
# --- 代码来源 ------------------------------------------------------------------------------------
# 启动脚本自动检测镜像内的 SITE（vLLM site-packages），并在挂载前探测镜像自带的
# mimo_v2.py / mimo_v2_omni.py 是否与补丁覆盖的 API 一致；设置 SITE= 可覆盖。
# 原始模块的 SHA-256 记入日志以便核对（与您已知的正常版本清单比较）。