# ================================================================================
# MANDATORY (the launcher refuses to start without this):
# ================================================================================
# IMAGE="vllm/vllm-openai:nightly-8e2beaa3bff595577a069d49d96bde9074294ec2@sha256:167ccd8696bc09f1b63301185134e04b883623f8adcbd8e3a0ec3140a193abcf"
#                # REQUIRED -- concrete pinned nightly (tag = vLLM commit); floating tags refused
# API_KEY=                                     # optional on loopback: auto-generated into live/api_key
#                # REQUIRED only for a non-loopback BIND (any routable address)
#                # ALLOW_NO_AUTH=1 is accepted ONLY together with BIND=127.0.0.1
# MODEL_REVISION=<40-hex commit SHA>          # REQUIRED when MODEL_ID is used (not with MODEL_DIR)
# MODEL_DIR=$HOME/models/MiMo-V2.6-Pro-MOPD        # local checkpoint dir -- OR use MODEL_ID + MODEL_REVISION
#
# Get the values:
#   digest:    docker buildx imagetools inspect <repo>:<tag> | grep Digest
#   API key:   API_KEY=$(openssl rand -hex 24)
#   revision:  curl -fsSL https://huggingface.co/api/models/<MODEL_ID> | python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])'
# ================================================================================
# OPTIONAL settings (defaults shown; copy this file to tp4.env and edit):
# ================================================================================
# Knobs read by scripts/run-tp4-hotsplit.sh (export them or prefix the command). Values shown are the defaults
# unless marked "example". Static values validated on target hardware (2026-10-23); dynamic values not yet hardware-verified.

# --- server -------------------------------------------------------------------------------------
# MODEL_DIR=$HOME/models/MiMo-V2.6-Pro-MOPD     # example; otherwise MODEL_ID is pulled into ~/.cache/huggingface
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=1
CPU_OFFLOAD_GB=128            # per rank; MUST cover the per-rank expert bank (~123 GiB for MiMo) or the Marlin conversion runs out of VRAM; pinned RAM = 4 x this value
GPU_UTIL=0.85               # leave VRAM headroom for the Marlin weight-format conversion
MOE_BACKEND=humming         # OBSERVED on target hardware (2026-10-22): the only backend that both
#                # supports MoEActivation.SILU (triton rejects it) AND avoids the Marlin GPU repack
#                # (marlin OOMs with UVA offload). Both launchers default to humming now; marlin
#                # is refused unless HOTSPLIT_ALLOW_MARLIN_UVA=1 (debugging only).
PATCH_MODEL_FILES=1          # 0 = image's own mimo_v2.py, hook installed by sitecustomize instead

# --- hotsplit -----------------------------------------------------------------------------------
HOTSPLIT_DYNAMIC=1           # 0 = static hotsplit (per rank)
HOTSPLIT_DRYRUN=0            # 1 = log the plan and leave the weights alone
HOTSPLIT_HOT_GIB=30          # PER RANK. REQUIRED here: with full UVA offload the default budget is 0
#                # (empty hot set -> the split is a silent no-op). 30 GiB is the verified start.
HOTSPLIT_WEIGHTS=decode=1,prefill=0
# HOTSPLIT_COUNTS_MODE=phase-balanced  # or traffic-weighted (phase contribution by raw volume)
HOTSPLIT_HOST_FLOOR_GIB=128  # stop splitting when free host RAM (all 4 ranks assumed) would drop below this

# --- dynamic updates (HOTSPLIT_DYNAMIC=1) -------------------------------------------------------
# HOTSPLIT_DYN_STEPS=2000          # engine steps between updates
# HOTSPLIT_DYN_MAX_SWAPS=2         # hot<->cold swaps per layer per update (bounds the stall)
# HOTSPLIT_DYN_DECAY=0.5           # score = decay * score + routed count since last update
# HOTSPLIT_DYN_MARGIN=1.25         # swap only if incoming score > margin * outgoing score
# HOTSPLIT_DYN_PRIOR_TOKENS=2000   # weight of the offline ranking, in decode tokens
# HOTSPLIT_DYN_LOG=1               # log every update (adds one device sync per update)
# HOTSPLIT_DYN_MAX_PLAN_ERRORS=3   # consecutive planner failures before the run aborts (>=1)
# HOTSPLIT_DYN_MAX_COMMIT_ERRORS=3  # consecutive failed/rolled-back weight swaps before abort (>=1)
# HOTSPLIT_TOPK=8
# HOTSPLIT_LIVE_DECODE_MAX=16      # count only steps with at most this many tokens

# --- NUMA ---------------------------------------------------------------------------------------
HOTSPLIT_NUMA=1              # pin each worker to the NUMA node of its GPU (needs --cap-add SYS_NICE, set by the launcher)
HOTSPLIT_NUMA_POLICY=preferred   # or bind (strict; fails/ooms if the node is full)

# --- telemetry ----------------------------------------------------------------------------------
# The launcher always sets HOTSPLIT_LIVE_COUNTS=/live/counts.json; every rank writes its own
# counts.rank<N>.json every 600 s into $LIVE_DIR (default ./live).

# --- VRAM headroom (pre-check reserve) ----------------------------------------------------------
# HOTSPLIT_VRAM_RESERVE_GIB=2   # reserve for CUDA-graph buffers, Marlin workspace and later
#                                 KV-cache allocations; the pre-check refuses to split a layer
#                                 when (free VRAM - hot copy) < this. Floor is 2 GiB.
# --- strict hook / NUMA failure handling --------------------------------------------------------
# HOTSPLIT_STRICT_HOOK=0        # 1 = a failed boot/NUMA hook is FATAL (SystemExit), not a warning
# HOTSPLIT_NUMA_STRICT=0        # 1 = a failed NUMA binding aborts the worker (see numa_bind.py)
# --- provenance ------------------------------------------------------------------------------
# The launcher auto-detects SITE (vLLM site-packages) inside the image and probes the image's own
# mimo_v2.py / mimo_v2_omni.py for the API our patches override before mounting; set SITE= to
# override. Original module SHA-256 is logged for provenance (compare with your known-good list).
