# ================================================================================
# MANDATORY (the launcher refuses to start without these):
# ================================================================================
# IMAGE="vllm/vllm-openai:nightly-8e2beaa3bff595577a069d49d96bde9074294ec2@sha256:167ccd8696bc09f1b63301185134e04b883623f8adcbd8e3a0ec3140a193abcf"
#                # REQUIRED -- concrete pinned nightly (tag = vLLM commit); floating tags refused
# API_KEY=<your key>                          # REQUIRED (or ALLOW_NO_AUTH=1 with BIND=127.0.0.1 only)
# MODEL_REVISION=<40-hex commit SHA>          # REQUIRED when MODEL_ID is used (not with MODEL_DIR)
# MODEL_DIR=/models/<ModelName>               # local checkpoint dir -- OR use MODEL_ID + MODEL_REVISION
#
# Get the values:
#   digest:    docker buildx imagetools inspect <repo>:<tag> | grep Digest
#   API key:   API_KEY=$(openssl rand -hex 24)
#   revision:  curl -fsSL https://huggingface.co/api/models/<MODEL_ID> | python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])'
# ================================================================================
# OPTIONAL settings (defaults shown; copy this file to tp4.env and edit):
# ================================================================================
# Knobs for GLM-5.3 on 4x RTX PRO 6000. Values shown are the defaults unless marked "example".
# Authored, not validated on target hardware.

# --- expert balance (patches/hotsplit_balance.py) -------------------------------------------
# HOTSPLIT_HOT_GIB=36      # PER RANK hot budget; ladder 31 / 36 / 41 GiB. Empty = full bank in GPU memory
# HOTSPLIT_COUNTS=/work/expert_hist_mix.json   # routing histogram of YOUR traffic (see balance.sh)
HOTSPLIT_WEIGHTS=decode=1,prefill=0
HOTSPLIT_TOPK=8

# --- server ---------------------------------------------------------------------------------
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=1
CPU_OFFLOAD_GB=96        # per rank UVA offload cap
GPU_UTIL=0.90

# --- host floor -----------------------------------------------------------------------------
HOTSPLIT_HOST_FLOOR_GIB=128   # stop splitting when free host RAM (all 4 ranks) would drop below this
