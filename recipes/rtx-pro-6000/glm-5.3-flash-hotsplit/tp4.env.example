# ================================================================================
# MANDATORY (the launcher refuses to start without these):
# ================================================================================
# IMAGE="vllm/vllm-openai:nightly-8e2beaa3bff595577a069d49d96bde9074294ec2@sha256:167ccd8696bc09f1b63301185134e04b883623f8adcbd8e3a0ec3140a193abcf"
#                # SEMANTICS BY MODE (kv-persistence r20 K1):
#                #  * KV_PERSIST=1 (cache ON): this line is the BASE PIN, not the image that runs.
#                #    The launcher checks it against the base of the CUSTOM image in
#                #    live/image (by digest) and launches the CUSTOM one. Keep the concrete
#                #    pinned nightly (tag = vLLM commit) -- floating tags refused. To force a
#                #    specific custom build instead: IMAGE="$(cat <kv-persistence>/live/image)".
#                #  * KV_PERSIST=0 (stock runs): IMAGE is used exactly as written here and is
#                #    NOT resolved or checked against live/image.
#                #  * A failed launch never touches live/image (it is written only after a
#                #    successful custom-image verify).
# API_KEY=<your key>                          # REQUIRED (or ALLOW_NO_AUTH=1 with BIND=127.0.0.1 only)
# MODEL_REVISION=<40-hex commit SHA>          # REQUIRED when MODEL_ID is used (not with MODEL_DIR)
# MODEL_DIR=$HOME/models/<ModelName>               # local checkpoint dir -- OR use MODEL_ID + MODEL_REVISION
#
# Get the values:
#   digest:    docker buildx imagetools inspect <repo>:<tag> | grep Digest
#   API key:   API_KEY=$(openssl rand -hex 24)
#   revision:  curl -fsSL https://huggingface.co/api/models/<MODEL_ID> | python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])'
# ================================================================================
# OPTIONAL settings (defaults shown; copy this file to tp4.env and edit):
# ================================================================================
# Knobs for GLM-5.3-Flash on 4x RTX PRO 6000. Values shown are the defaults unless marked "example".
# Authored, not validated on target hardware.

# --- expert balance (patches/hotsplit_balance.py) -------------------------------------------
# HOTSPLIT_HOT_GIB=31      # PER RANK hot budget; ladder 26 / 31 / 36 GiB. Empty = full bank in GPU memory
# HOTSPLIT_COUNTS=/work/expert_hist_mix.json   # routing histogram of YOUR traffic (see balance.sh)
HOTSPLIT_WEIGHTS=decode=1,prefill=0
HOTSPLIT_TOPK=8

# --- server ---------------------------------------------------------------------------------
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=1
CPU_OFFLOAD_GB=48        # per rank UVA offload cap -- MUST cover the per-rank expert bank (see wiki Models-and-Geometry); pinned RAM = 4 x this value
GPU_UTIL=0.85               # leave VRAM headroom for the Marlin weight-format conversion
MOE_BACKEND=humming         # supports MoEActivation.SILU and does not repack weights into VRAM.
#                # OBSERVED on target hardware: triton rejects SILU on MiMo; marlin repacks into VRAM
#                # and OOMs with UVA offload -- use marlin only when weights fit on GPU.

# --- host floor -----------------------------------------------------------------------------
HOTSPLIT_HOST_FLOOR_GIB=128   # stop splitting when free host RAM (all 4 ranks) would drop below this
