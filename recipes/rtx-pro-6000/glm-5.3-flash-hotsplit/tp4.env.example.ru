# ================================================================================
# ОБЯЗАТЕЛЬНЫЕ настройки (лаунчер отказывается стартовать без них):
# ================================================================================
# IMAGE="vllm/vllm-openai:nightly-8e2beaa3bff595577a069d49d96bde9074294ec2@sha256:167ccd8696bc09f1b63301185134e04b883623f8adcbd8e3a0ec3140a193abcf"
#                # обязательно -- конкретный закреплённый nightly (тег = коммит vLLM); плавающие теги отклоняются
# API_KEY=<ваш ключ>                          # обязателен (или ALLOW_NO_AUTH=1 только вместе с BIND=127.0.0.1)
# MODEL_REVISION=<40-hex коммит SHA>          # обязателен при использовании MODEL_ID (не при MODEL_DIR)
# MODEL_DIR=$HOME/models/<ModelName>               # локальный каталог с весами -- ИЛИ MODEL_ID + MODEL_REVISION
#
# Как получить значения:
#   digest:    docker buildx imagetools inspect <repo>:<tag> | grep Digest
#   API-ключ:  API_KEY=$(openssl rand -hex 24)
#   ревизия:   curl -fsSL https://huggingface.co/api/models/<MODEL_ID> | python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])'
# ================================================================================
# НЕОБЯЗАТЕЛЬНЫЕ настройки (показаны значения по умолчанию; скопируйте файл в tp4.env и правьте):
# ================================================================================
# Ручки для GLM-5.3-Flash на 4x RTX PRO 6000. Показаны значения по умолчанию, если не помечено "пример".
# Написано, но не проверено на целевом железе.

# --- баланс экспертов (patches/hotsplit_balance.py) -------------------------------------------
# HOTSPLIT_HOT_GIB=31      # бюджет hot НА RANK; лестница 26 / 31 / 36 GiB. Пусто = весь банк в GPU-памяти
# HOTSPLIT_COUNTS=/work/expert_hist_mix.json   # гистограмма маршрутизации ВАШЕГО трафика (см. balance.sh)
HOTSPLIT_WEIGHTS=decode=1,prefill=0
HOTSPLIT_TOPK=8

# --- сервер -------------------------------------------------------------------------------------
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=1
CPU_OFFLOAD_GB=48        # лимит UVA-выгрузки НА RANK -- ОБЯЗАН покрывать банк экспертов на rank (см. wiki Models-and-Geometry); pinned RAM = 4 x это значение
GPU_UTIL=0.85               # оставляет запас VRAM под конвертацию весов в формат Marlin
MOE_BACKEND=humming         # поддерживает MoEActivation.SILU и не перепаковывает веса в VRAM.
#                # наблюдено на целевом железе: triton отвергает SILU на MiMo; marlin перепаковывает
#                # в VRAM и падает с OOM при UVA-выгрузке -- используйте marlin только когда веса
#                # помещаются в GPU.

# --- нижний порог хоста -------------------------------------------------------------------------
HOTSPLIT_HOST_FLOOR_GIB=128   # прекратить разбиение, если свободная RAM хоста (с учётом всех 4 rank) упадёт ниже этого