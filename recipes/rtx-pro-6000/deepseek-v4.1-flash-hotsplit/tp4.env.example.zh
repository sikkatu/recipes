# ================================================================================
# 必填设置（缺少时启动脚本拒绝启动）：
# ================================================================================
# IMAGE="vllm/vllm-openai:nightly-8e2beaa3bff595577a069d49d96bde9074294ec2@sha256:167ccd8696bc09f1b63301185134e04b883623f8adcbd8e3a0ec3140a193abcf"
#                # 必填 —— 具体的锁定 nightly（标签 = vLLM 提交）；浮动标签被拒绝
# API_KEY=<你的密钥>                          # 必填（或 ALLOW_NO_AUTH=1 仅与 BIND=127.0.0.1 同用）
# MODEL_REVISION=<40位十六进制提交 SHA>          # 使用 MODEL_ID 时必填（用 MODEL_DIR 时不需要）
# MODEL_DIR=$HOME/models/<ModelName>               # 本地权重目录 —— 或使用 MODEL_ID + MODEL_REVISION
#
# 如何获取这些值：
#   digest:    docker buildx imagetools inspect <repo>:<tag> | grep Digest
#   API 密钥:  API_KEY=$(openssl rand -hex 24)
#   修订版本:  curl -fsSL https://huggingface.co/api/models/<MODEL_ID> | python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])'
# ================================================================================
# 可选设置（显示默认值；复制本文件为 tp4.env 并编辑）：
# ================================================================================
# DeepSeek-V4.1-Flash 在 4x RTX PRO 6000 上的配置项。除标注"示例"外，显示的均为默认值。
# 已编写，但未在目标硬件上验证。

# --- 专家均衡（patches/hotsplit_balance.py） ------------------------------------------------
# HOTSPLIT_HOT_GIB=52      # 每 rank 的 hot 预算；阶梯 47 / 52 / 57 GiB。留空 = 整个库在 GPU 显存中
# HOTSPLIT_COUNTS=/work/expert_hist_mix.json   # 你的真实流量的路由直方图（见 balance.sh）
HOTSPLIT_WEIGHTS=decode=1,prefill=0
HOTSPLIT_TOPK=6

# --- 服务器 -----------------------------------------------------------------------------------
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=1
CPU_OFFLOAD_GB=72        # 每 rank 的 UVA 卸载上限 —— 必须覆盖每 rank 的专家库（见 wiki Models-and-Geometry）；pinned RAM = 4 × 此值
GPU_UTIL=0.85               # 为 Marlin 权重格式转换保留 VRAM 余量
MOE_BACKEND=humming         # 支持 MoEActivation.SILU 且不把权重重打包进 VRAM。
#                # 目标硬件实测：triton 在 MiMo 上拒绝 SILU；marlin 会重打包进 VRAM，
#                # UVA 卸载时 OOM —— 仅当权重能放进 GPU 时才用 marlin。

# --- 主机下限 ---------------------------------------------------------------------------------
HOTSPLIT_HOST_FLOOR_GIB=128   # 当主机空闲 RAM（按全部 4 rank 计算）降到此值以下时停止拆分