# Knobs for DeepSeek-V4.1-Flash on 4x RTX PRO 6000. Values shown are the defaults unless marked "example".
# Authored, not validated on target hardware.

# --- expert balance (patches/hotsplit_balance.py) -------------------------------------------
# HOTSPLIT_HOT_GIB=52      # PER RANK hot budget; ladder 47 / 52 / 57 GiB. Empty = full bank in GPU memory
# HOTSPLIT_COUNTS=/work/expert_hist_mix.json   # routing histogram of YOUR traffic (see balance.sh)
HOTSPLIT_WEIGHTS=decode=1,prefill=0
HOTSPLIT_TOPK=6

# --- server ---------------------------------------------------------------------------------
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=1
CPU_OFFLOAD_GB=96        # per rank UVA offload cap
GPU_UTIL=0.90

# --- host floor -----------------------------------------------------------------------------
HOTSPLIT_HOST_FLOOR_GIB=128   # stop splitting when free host RAM (all 4 ranks) would drop below this
